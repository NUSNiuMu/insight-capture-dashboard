Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.8
      Class: rviz_default_plugins/Grid
      Cell Size: 0.5
      Name: Grid
      Plane: XY
      Reference Frame: insight9_map
      Value: true
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/PointCloud2
      Color: 70; 200; 255
      Color Transformer: FlatColor
      Decay Time: 0
      Name: Confirmed sparse map
      Position Transformer: XYZ
      Queue Size: 2
      Selectable: true
      Size (Pixels): 3
      Size (m): 0.02
      Style: Points
      Topic:
        Depth: 2
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /insight9_sparse_map/points
      Use Fixed Frame: true
      Value: true
    - Alpha: 0.9
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 80; 70
      Color Transformer: FlatColor
      Decay Time: 0
      Name: Current triangulated frame
      Position Transformer: XYZ
      Queue Size: 2
      Selectable: true
      Size (Pixels): 5
      Size (m): 0.025
      Style: Points
      Topic:
        Depth: 2
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /insight9_sparse_map/current_points
      Use Fixed Frame: true
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Image Topic:
        Depth: 2
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /insight9_sparse_map/debug_matches
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: Stereo match validation
      Normalize Range: true
      Queue Size: 2
      Transport Hint: raw
      Value: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 255; 180; 30
      Head Diameter: 0.03
      Head Length: 0.05
      Length: 0.05
      Line Style: Lines
      Line Width: 0.02
      Name: VIO camera path
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Color: 255; 85; 0
      Pose Style: None
      Radius: 0.03
      Shaft Diameter: 0.01
      Shaft Length: 0.03
      Topic:
        Depth: 2
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /insight9_sparse_map/path
      Value: true
  Enabled: true
  Global Options:
    Background Color: 28; 28; 32
    Fixed Frame: insight9_map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 4
      Focal Point:
        X: 0
        Y: 0
        Z: 1
      Name: Current View
      Pitch: 0.45
      Target Frame: insight9_map
      Yaw: 0.75
Window Geometry:
  Height: 900
  Width: 1440
