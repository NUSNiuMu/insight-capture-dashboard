      "namespace": "egohalo",
      "ros_domain_id": 0,
      "enabled": true,
      "dashboard_label": "EgoHalo",
      "teleop_role": "head",
      "dashboard_pose_stream": "/insight9_sparse_map/pose",
      "dashboard_cov_stream": "",
      "record_topics": [
        "/egohalo/camera/vio_image",
        "/egohalo/camera/vio_status"
