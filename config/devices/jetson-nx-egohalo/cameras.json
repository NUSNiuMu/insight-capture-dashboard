    "ntp_samples": 5,
    "clock_sample_interval_sec": 5.0,
    "keyframe_lead_in_sec": 1.1,
    "max_video_header_gap_pct": 0.1,
    "clock_devices": [
      {"name": "EgoHalo", "host": "169.254.10.1"},
      {"name": "Insight3 A", "host": "169.254.20.1"},
      {"name": "Insight3 B", "host": "169.254.30.1"}
