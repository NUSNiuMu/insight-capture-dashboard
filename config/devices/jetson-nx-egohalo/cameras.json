      "avatar_model": "assets/models/vis_assembly.glb",
      "camera_center_to_tcp": {
        "translation_m": [
          0.0,
          0.08,
          0.18
        ],
        "rotation_xyzw": [
          0.0,
          0.0,
          0.0,
          1.0
        ]
      },
      "dashboard_row": 0,
      "dashboard_column": 0
    },
    {
      "name": "insight3_b",
      "enabled": true,
      "namespace": "insight3_b",
      "dashboard_image_stream": "infra1",
