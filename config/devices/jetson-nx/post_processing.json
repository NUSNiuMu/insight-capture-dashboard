{
  "rosbag_dir": "rosbags",
  "results_dir": "outputs/results",
  "max_cache_size": 104857600,
  "record_topics": [],
  "insight3_global_localizer": {
    "gripper_mask_height_ratio": 0.2
  },
  "gesture_recording": {
    "enabled": false,
    "camera": "insight9_a",
    "hold_sec": 0.8,
    "hold_gap_sec": 0.15,
    "release_sec": 2.0,
    "snapshot_timeout_sec": 0.35,
    "min_keypoint_score": 0.35,
    "min_free_ratio": 0.1
  },
  "voice_recording": {
    "enabled": false,
    "device": "plughw:YDPI4MIC,0",
    "model_path": "/opt/insight/models/vosk-cn-small",
    "sample_rate": 16000,
    "cooldown_sec": 2.0,
    "min_free_ratio": 0.1,
    "start_phrases": ["开始录制"],
    "stop_phrases": ["结束录制", "停止录制"]
  },
  "capture_check": {
    "enabled": true,
    "sample_window_sec": 1.2,
    "minimum_window_sec": 0.8,
    "minimum_samples": 12,
    "maximum_pose_age_sec": 0.5,
    "stationary_translation_m": 0.01,
    "stationary_rotation_deg": 2.0,
    "pass_translation_m": 0.015,
    "pass_rotation_deg": 3.0,
    "recalibrate_translation_m": 0.03,
    "recalibrate_rotation_deg": 6.0,
    "minimum_map_points": 30
  }
}
