{
  "rosbag_dir": "rosbags",
  "results_dir": "outputs/results",
  "max_cache_size": 104857600,
  "record_topics": [],
  "insight3_global_localizer": {
    "gripper_mask_height_ratio": 0.2
  },
  "gesture_recording": {"enabled": false},
  "voice_recording": {"enabled": false},
  "capture_check": {
    "enabled": true,
    "sample_window_sec": 1.2,
    "minimum_window_sec": 0.8,
    "minimum_samples": 12,
    "maximum_pose_age_sec": 0.5,
    "camera_threshold_groups": {
      "insight7_a": "insight7_localizer",
      "insight7_b": "insight7_localizer",
      "insight7_c": "insight7_mapper"
    },
    "insight7_localizer": {
      "stationary_translation_m": 0.006,
      "stationary_rotation_deg": 1.5,
      "pass_translation_m": 0.01,
      "pass_rotation_deg": 2.0,
      "recalibrate_translation_m": 0.025,
      "recalibrate_rotation_deg": 5.0
    },
    "insight7_mapper": {
      "stationary_translation_m": 0.025,
      "stationary_rotation_deg": 5.0,
      "pass_translation_m": 0.04,
      "pass_rotation_deg": 8.0,
      "recalibrate_translation_m": 0.08,
      "recalibrate_rotation_deg": 15.0
    },
    "minimum_map_points": 30
  }
}
