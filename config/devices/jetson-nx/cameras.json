{
  "ros_domain_id": 20,
  "dashboard": {
    "window_title": "Insight Monitoring Dashboard",
    "fullscreen": true,
    "trajectory": {
      "max_points": 300,
      "view_yaw_deg": -35,
      "view_pitch_deg": 28,
      "ui_refresh_ms": 50,
      "image_decode_reduction": 0,
      "display_fps_limit": 20,
      "image_qos_reliability": "reliable",
      "pose_timeout_sec": 2.0,
      "camera_stale_timeout_sec": 2.0,
      "title": "3D Global Trajectory",
      "subtitle": "Interactive 3D view driven by mapping and relocalization poses.",
      "axis_label": "x/y plane, z up",
      "pose_publish_hz": 50.0
    }
  },
  "cameras": [
    {
      "name": "insight3_a",
      "enabled": true,
      "namespace": "insight3_a",
      "label": "Insight3 A",
      "dashboard_image_stream": "infra1",
      "dashboard_label": "Insight3 A Infrared",
      "dashboard_pose_stream": "/insight_global/insight3_a/pose",
      "dashboard_path_topic": "/insight_global/insight3_a/path",
      "dashboard_rotation_deg": 0,
      "teleop_role": "right_hand",
      "avatar_model": "assets/models/vis_assembly.glb",
      "dashboard_color": "#ff5a5a",
      "dashboard_row": 0,
      "dashboard_column": 0,
      "dashboard_row_span": 1,
      "dashboard_column_span": 1
    },
    {
      "name": "insight3_b",
      "enabled": true,
      "namespace": "insight3_b",
      "label": "Insight3 B",
      "dashboard_image_stream": "infra1",
      "dashboard_label": "Insight3 B Infrared",
      "dashboard_pose_stream": "/insight_global/insight3_b/pose",
      "dashboard_path_topic": "/insight_global/insight3_b/path",
      "dashboard_rotation_deg": 0,
      "teleop_role": "left_hand",
      "avatar_model": "assets/models/vis_assembly.glb",
      "dashboard_color": "#4aa8ff",
      "dashboard_row": 1,
      "dashboard_column": 0,
      "dashboard_row_span": 1,
      "dashboard_column_span": 1
    },
    {
      "name": "insight9_a",
      "enabled": true,
      "namespace": "insight9_a",
      "label": "Insight9 A",
      "dashboard_image_stream": "color_compressed",
      "dashboard_label": "Insight9 A Color",
      "dashboard_pose_stream": "/insight9_sparse_map/pose",
      "dashboard_path_topic": "/insight9_sparse_map/path",
      "dashboard_rotation_deg": 0,
      "teleop_role": "head",
      "avatar_model": "assets/models/iron-man_helmet_mk3_optimized.glb",
      "dashboard_color": "#57d67c",
      "dashboard_row": 0,
      "dashboard_column": 1,
      "dashboard_row_span": 2,
      "dashboard_column_span": 1
    }
  ]
}
