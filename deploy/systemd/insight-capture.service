[Unit]
Description=Insight capture backpack services
After=docker.service network-online.target
Wants=docker.service network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=nvidia
Group=nvidia
WorkingDirectory=/home/nvidia/insight-capture-dashboard
ExecStart=/home/nvidia/insight-capture-dashboard/deploy/device_services.sh start
ExecStop=/home/nvidia/insight-capture-dashboard/deploy/device_services.sh stop
TimeoutStartSec=1200

[Install]
WantedBy=multi-user.target
