# Copy to deploy/vlm/.env (not tracked) and adjust for this GPU machine.
# Qwen3.8-27B-FP8 needs ~30 GB VRAM; Qwen2.5-VL-7B-Instruct (~17 GB) also works.
MODEL=/home/deepmirror/Workspace/Qwen3.8-27B-FP8
# Environment from deploy/vlm/setup_env.sh
PYTHON=/home/deepmirror/Workspace/.venvs/vlm/bin/python
PORT=8780
# The Hub is slow here; the FP8 kernel is cached after the first fetch, the mirror covers update checks.
HF_ENDPOINT=https://hf-mirror.com
