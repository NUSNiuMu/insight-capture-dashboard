# Large runtime data — never bake into image; use volume mounts
rosbags/
data/
runs/
outputs/
bags/
gesture/

# Git and IDE
.git/
.claude/
.gitignore
CLAUDE.md
AGENTS.md

# Node build artifacts (dist/ is checked in and needed; node_modules is not)
web_dashboard/node_modules/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# macOS
.DS_Store

# Release artifacts (multi-GB image tarballs from scripts/build_release.sh)
release/

# Local review/report outputs must never be baked into customer images
Ego_数据采集与交付规范.pdf
dashboard-preview.png
ego_compliance_report_assets/
multiview_handpose_report_assets/

# CAD source for export_gripper_split_from_stl.py (dev tool); the runtime
# only needs the exported .glb files
assets/models/*.stl

# Desktop Qt is distributed as its two built runtime artifacts, not build caches.
.native-build/*
!.native-build/insight-native
!.native-build/qt-runtime.tar
native_dashboard/*
!native_dashboard/run.sh
native_mapping/
tests/
docs/
web_dashboard/src/
web_dashboard/build.js
web_dashboard/package.json

# PDFs are documentation or user attachments, never backend runtime inputs.
*.pdf

.env
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
