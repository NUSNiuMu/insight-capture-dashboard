# Contains Magic Leap's official SuperPoint/SuperGlue code and weights.
# Commercial/redistribution use confirmed with Magic Leap.
FROM nvcr.io/nvidia/pytorch@sha256:d4a2f7f873bf0bbb72c2b15dc07860369c760dfda2348859826947bc71a88248 AS onnx-builder

ARG DEBIAN_FRONTEND=noninteractive
ARG SUPERGLUE_COMMIT=ddcf11f42e7e0732a0c4607648f9448ea8d73590

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates git \
    && rm -rf /var/lib/apt/lists/*

RUN git clone --filter=blob:none https://github.com/magicleap/SuperGluePretrainedNetwork.git \
        /opt/SuperGluePretrainedNetwork \
    && git -C /opt/SuperGluePretrainedNetwork checkout --detach "${SUPERGLUE_COMMIT}" \
    && test "$(git -C /opt/SuperGluePretrainedNetwork rev-parse HEAD)" = "${SUPERGLUE_COMMIT}" \
    && printf '%s  %s\n' \
        52b6708629640ca883673b5d5c097c4ddad37d8048b33f09c8ca0d69db12c40e \
        /opt/SuperGluePretrainedNetwork/models/weights/superpoint_v1.pth \
        0e710469be25ebe1e2ccf68edcae8b2945b0617c8e7e68412251d9d47f5052b1 \
        /opt/SuperGluePretrainedNetwork/models/weights/superglue_indoor.pth \
        2f5f5e9bb3febf07b69df633c4c3ff7a17f8af26a023aae2b9303d22339195bd \
        /opt/SuperGluePretrainedNetwork/models/weights/superglue_outdoor.pth \
        | sha256sum -c -

COPY insight_capture/runtime/mapping/superglue_tensorrt.py /opt/insight/superglue_tensorrt.py
COPY scripts/export_superglue_onnx.py /opt/insight/export_superglue_onnx.py
RUN cd /opt/insight && python3 export_superglue_onnx.py

FROM nvcr.io/nvidia/tensorrt@sha256:cb601071a1fda9248bbad591829f65943bd8dd23d5fe81b7c41f5390d0e1b03e AS tensorrt-source

FROM ubuntu:24.04

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libstdc++6 \
        python3-minimal \
        python3-numpy \
    && rm -rf /var/lib/apt/lists/*

# The NGC TensorRT image is a development environment containing CUDA toolkit,
# HPC-X/NCCL, samples, headers, and profilers. This worker only needs the
# TensorRT Python binding plus the libraries used for engine construction and
# inference. Jetson driver/DLA libraries are injected by the NVIDIA runtime.
COPY --from=tensorrt-source /usr/local/lib/python3.12/dist-packages/tensorrt \
    /usr/local/lib/python3.12/dist-packages/tensorrt
COPY --from=tensorrt-source /usr/local/lib/python3.12/dist-packages/tensorrt-10.9.0.34.dist-info \
    /usr/local/lib/python3.12/dist-packages/tensorrt-10.9.0.34.dist-info
COPY --from=tensorrt-source /usr/lib/aarch64-linux-gnu/libnvinfer.so.10.9.0 \
    /usr/lib/aarch64-linux-gnu/libnvinfer.so.10.9.0
COPY --from=tensorrt-source /usr/lib/aarch64-linux-gnu/libnvinfer_plugin.so.10.9.0 \
    /usr/lib/aarch64-linux-gnu/libnvinfer_plugin.so.10.9.0
COPY --from=tensorrt-source /usr/lib/aarch64-linux-gnu/libnvinfer_builder_resource.so.10.9.0 \
    /usr/lib/aarch64-linux-gnu/libnvinfer_builder_resource.so.10.9.0
COPY --from=tensorrt-source /usr/lib/aarch64-linux-gnu/libnvonnxparser.so.10.9.0 \
    /usr/lib/aarch64-linux-gnu/libnvonnxparser.so.10.9.0
COPY --from=tensorrt-source /usr/local/cuda-12.9/targets/aarch64-linux/lib/libcudart.so.12.9.37 \
    /usr/local/cuda/targets/aarch64-linux/lib/libcudart.so.12.9.37
COPY --from=tensorrt-source /usr/local/cuda-12.9/targets/aarch64-linux/lib/libcudla.so.1.0.0 \
    /usr/local/cuda/targets/aarch64-linux/lib/libcudla.so.1.0.0
COPY --from=tensorrt-source /usr/local/cuda-12.9/targets/aarch64-linux/lib/libnvrtc.so.12.9.41 \
    /usr/local/cuda/targets/aarch64-linux/lib/libnvrtc.so.12.9.41
COPY --from=tensorrt-source /usr/local/cuda-12.9/targets/aarch64-linux/lib/libnvrtc-builtins.so.12.9.41 \
    /usr/local/cuda/targets/aarch64-linux/lib/libnvrtc-builtins.so.12.9.41
COPY --from=tensorrt-source /opt/tensorrt/bin/trtexec /opt/tensorrt/bin/trtexec
RUN ln -s libnvinfer.so.10.9.0 /usr/lib/aarch64-linux-gnu/libnvinfer.so.10 \
    && ln -s libnvinfer.so.10 /usr/lib/aarch64-linux-gnu/libnvinfer.so \
    && ln -s libnvinfer_plugin.so.10.9.0 /usr/lib/aarch64-linux-gnu/libnvinfer_plugin.so.10 \
    && ln -s libnvinfer_plugin.so.10 /usr/lib/aarch64-linux-gnu/libnvinfer_plugin.so \
    && ln -s libnvonnxparser.so.10.9.0 /usr/lib/aarch64-linux-gnu/libnvonnxparser.so.10 \
    && ln -s libnvonnxparser.so.10 /usr/lib/aarch64-linux-gnu/libnvonnxparser.so \
    && ln -s libcudart.so.12.9.37 /usr/local/cuda/targets/aarch64-linux/lib/libcudart.so.12 \
    && ln -s libcudart.so.12 /usr/local/cuda/targets/aarch64-linux/lib/libcudart.so \
    && ln -s libcudla.so.1.0.0 /usr/local/cuda/targets/aarch64-linux/lib/libcudla.so.1 \
    && ln -s libcudla.so.1 /usr/local/cuda/targets/aarch64-linux/lib/libcudla.so \
    && ln -s libnvrtc.so.12.9.41 /usr/local/cuda/targets/aarch64-linux/lib/libnvrtc.so.12 \
    && ln -s libnvrtc.so.12 /usr/local/cuda/targets/aarch64-linux/lib/libnvrtc.so \
    && ln -s libnvrtc-builtins.so.12.9.41 /usr/local/cuda/targets/aarch64-linux/lib/libnvrtc-builtins.so.12.9 \
    && ln -s libnvrtc-builtins.so.12.9 /usr/local/cuda/targets/aarch64-linux/lib/libnvrtc-builtins.so

COPY --from=onnx-builder /opt/insight/onnx /opt/insight/onnx
COPY insight_capture/runtime/mapping/superglue_ipc.py /opt/insight/superglue_ipc.py
COPY insight_capture/runtime/mapping/superglue_worker.py /opt/insight/superglue_inference_worker.py
COPY insight_capture/runtime/mapping/superglue_tensorrt_runtime.py /opt/insight/superglue_tensorrt_runtime.py
COPY scripts/prepare_superglue_tensorrt.py /opt/insight/prepare_superglue_tensorrt.py
COPY scripts/start_superglue_inference.sh /opt/insight/start_superglue_inference.sh
RUN chmod +x /opt/insight/start_superglue_inference.sh

WORKDIR /opt/insight

ENV LD_LIBRARY_PATH=/usr/local/cuda/targets/aarch64-linux/lib:/usr/lib/aarch64-linux-gnu \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility \
    NVIDIA_REQUIRE_JETPACK_HOST_MOUNTS=base-only \
    NVIDIA_VISIBLE_DEVICES=all

CMD ["/opt/insight/start_superglue_inference.sh"]
