@@ -644,0 +645,19 @@
+ReaderHistory::iterator DataReaderHistory::remove_fragmented_change_nts(
+        ReaderHistory::const_iterator removal)
+{
+    // GAP owns the WriterProxy update. Retain its no-callback removal semantics,
+    // but drop the DDS instance reference before the cache is returned to its pool.
+    if (removal != changesEnd())
+    {
+        CacheChange_t* change = *removal;
+        assert(!change->is_fully_assembled());
+        auto instance = instances_.find(change->instanceHandle);
+        if (instance != instances_.end())
+        {
+            auto& changes = instance->second->cache_changes;
+            changes.erase(std::remove(changes.begin(), changes.end(), change), changes.end());
+        }
+    }
+    return History::remove_change_nts(removal);
+}
