# Development visualization only; this image is not part of customer releases.
FROM insight-dashboard:latest

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends ros-humble-rviz2 \
    && rm -rf /var/lib/apt/lists/*

CMD ["rviz2", "-d", "/workspaces/insight_capture/config/rviz/insight9_global_localization.rviz"]
